{
  "manifest_version": 2,
  "name": "CookieGate",
  "version": "0.1.8",
  "description": "Cookie inspection, banner suppression, and cleanup planning for browser privacy.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cookiegate@local.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "browsingData",
    "cookies",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "ui/popup.html",
    "default_title": "CookieGate",
    "default_icon": {
      "16": "icons/cookiegate_16.png",
      "32": "icons/cookiegate_32.png",
      "48": "icons/cookiegate_48.png",
      "64": "icons/cookiegate_64.png",
      "128": "icons/cookiegate_128.png",
      "256": "icons/cookiegate_256.png"
    }
  },
  "icons": {
    "16": "icons/cookiegate_16.png",
    "32": "icons/cookiegate_32.png",
    "48": "icons/cookiegate_48.png",
    "64": "icons/cookiegate_64.png",
    "128": "icons/cookiegate_128.png",
    "256": "icons/cookiegate_256.png"
  },
  "short_name": "CookieGate",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "banner_suppression_runtime_v32.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}