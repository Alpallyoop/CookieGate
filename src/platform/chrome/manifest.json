{
  "manifest_version": 3,
  "name": "CookieGate",
  "version": "0.1.8",
  "description": "Cookie inspection, banner suppression, and cleanup planning for browser privacy.",
  "permissions": [
    "cookies",
    "browsingData",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker_clean_v011.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "CookieGate",
    "default_icon": {
      "16": "icons/cookiegate_16.png",
      "32": "icons/cookiegate_32.png",
      "48": "icons/cookiegate_48.png",
      "64": "icons/cookiegate_64.png",
      "128": "icons/cookiegate_128.png",
      "256": "icons/cookiegate_256.png"
    }
  },
  "icons": {
    "16": "icons/cookiegate_16.png",
    "32": "icons/cookiegate_32.png",
    "48": "icons/cookiegate_48.png",
    "64": "icons/cookiegate_64.png",
    "128": "icons/cookiegate_128.png",
    "256": "icons/cookiegate_256.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "banner_suppression_runtime_v32.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}